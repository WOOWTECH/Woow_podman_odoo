# First-run automatic database bootstrap without storing the first password here.
WOOW_ODOO_BIND=127.0.0.1
WOOW_ODOO_PORT=18069
WOOW_ODOO_IMAGE=
WOOW_ODOO_ADDONS_DIR=%h/.local/share/odoo18/addons
WOOW_ODOO_LIST_DB=True
WOOW_ODOO_DEFAULT_DB=odoo_test
WOOW_ODOO_ADMIN_LOGIN=operator@example.invalid
WOOW_ODOO_LANG=zh_TW
