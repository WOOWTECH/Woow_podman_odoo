# ~/.config/odoo18/odoo18.env: installer settings only, created by scripts/install.sh (mode 0600).
# Odoo takes its settings from the rendered odoo.conf secret, so this file is NOT mounted into any
# container. No credentials here: install.sh generates them into podman secrets:
#   odoo18-postgres-password   database role "odoo"
#   odoo18-admin-password      Odoo database-manager (master) password
#   odoo18-odoo-conf           the rendered /etc/odoo/odoo.conf
# Reveal the master password in a private terminal with:
#   podman secret inspect --showsecret --format '{{.SecretData}}' odoo18-admin-password
#
# Rules: KEY=VALUE, no quotes, no inline "# comments". After editing, run scripts/install.sh again.

# 127.0.0.1 (default), an IPv4 address of this host, or "all" (every address, IPv4 and IPv6).
WOOW_ODOO_BIND=127.0.0.1
WOOW_ODOO_PORT=18069
# Optional prebuilt Odoo image for a HA/PaaS module profile. Must include an immutable sha256 digest.
# Leave empty for the repository's default official Odoo image. Never put registry credentials here.
WOOW_ODOO_IMAGE=
# Host directory with your custom addons, mounted read-only at /mnt/extra-addons. %h = your home.
# Files must be world-readable (install.sh checks; --fix-addon-perms runs chmod -R o+rX).
WOOW_ODOO_ADDONS_DIR=%h/.local/share/odoo18/addons
# True shows Odoo's database manager (needed to create the first database). Set False afterwards.
WOOW_ODOO_LIST_DB=True
# Optional first-run database bootstrap (empty = manual database manager). The administrator password
# is generated into a separate Podman secret; only the non-secret login is written here. Use loopback
# binding for this first run, then change the bind/list_db settings after initialization.
WOOW_ODOO_DEFAULT_DB=
WOOW_ODOO_ADMIN_LOGIN=
WOOW_ODOO_LANG=zh_TW
