# Odoo 18 Community web. Image pinned by dated tag and digest (18.0-20260817); bump both in the repo,
# then run scripts/upgrade.sh.
#
# odoo.conf is a podman secret, rendered by scripts/install.sh from config/odoo.conf.template with the
# generated database and master passwords. The file sets db_host/db_port/db_user/db_password, so the
# stock /entrypoint.sh adds no --db_* arguments and wait-for-psql.py reads ODOO_RC. The passwords
# therefore appear in no environment variable, no process argument and no `podman inspect` output.
#
# Addons: a host directory mounted read-only. Odoo runs as uid 100 (gid 101) inside the rootless user
# namespace, so the files only need to be world-readable (install.sh checks o+rX). There is no chown
# and no :U, so the operator keeps editing the addons as themselves.
#
# The unit is odoo.service, deliberately not odoo18.service (see odoo-db.container).
[Unit]
Description=Woow Odoo 18 web
Documentation=https://github.com/WOOWTECH/Woow_podman_odoo
Requires=odoo-db.service
After=odoo-db.service

[Container]
ContainerName=odoo18-web
Image=docker.io/library/odoo:18.0-20260817@sha256:259fa933bf3ee7f3e375bd74d1e0bc28bd75955159723be477359e0fdb8acf67
Network=odoo.network
HostName=odoo18-web
Label=io.woowtech.stack=odoo18
PublishPort=@@ODOO_PUBLISH@@:8069
Volume=odoo-web-data.volume:/var/lib/odoo
Volume=@@WOOW_ODOO_ADDONS_DIR@@:/mnt/extra-addons:ro,Z
Secret=odoo18-odoo-conf,type=mount,target=/etc/odoo/odoo.conf,uid=100,gid=101,mode=0400
# /web/health answers without a database, so it checks the HTTP worker, not business data.
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8069/web/health
HealthInterval=15s
HealthTimeout=5s
HealthRetries=20
HealthStartPeriod=60s
NoNewPrivileges=true
PodmanArgs=--stop-timeout=30

[Service]
# A container stopped by systemd is stopped with SIGTERM: an entrypoint that does not
# trap it exits 143 (128+15), which would leave the unit failed after a clean stop.
SuccessExitStatus=143
Restart=always
TimeoutStartSec=900
TimeoutStopSec=60

[Install]
WantedBy=default.target
